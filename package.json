{
  "name": "virus-hunter",
  "version": "1.0.0",
  "description": "Fight viruses inside a computer - An action-packed 2.5D game",
  "main": "src-tauri/src/main.rs",
  "scripts": {
    "start": "npm run dev",
    "dev": "tauri dev",
    "dev:vite": "vite",
    "dev:tauri": "tauri dev",
    "build:renderer": "cd src && npx vite build --outDir ../build/renderer --emptyOutDir && cd .. && node scripts/finalize-html.js && node scripts/copy-assets.js",
    "build": "tauri build",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "build:mac": "tauri build --target universal-apple-darwin",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "build:electron": "npm run build:renderer && electron-builder --win",
    "preview": "npm run build:renderer && tauri build"
  },
  "keywords": [
    "game",
    "action",
    "virus",
    "3d"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "concurrently": "^8.2.2",
    "terser": "^5.46.0",
    "vite": "^5.0.0"
  }
}
