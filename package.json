{
  "name": "virus-hunter",
  "version": "1.0.0",
  "description": "Fight viruses inside a computer - An action-packed 2.5D game",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron . --dev",
    "build:renderer": "vite build && node scripts/finalize-html.js && node scripts/copy-assets.js",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "preview": "npm run build:renderer && electron . --preview"
  },
  "build": {
    "appId": "com.virushunter.game",
    "productName": "Virus Hunter",
    "files": [
      "src/main.js",
      "src/preload.js",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false
    }
  },
  "keywords": [
    "game",
    "action",
    "virus",
    "3d"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "vite": "^5.0.0",
    "wait-on": "^7.0.1"
  }
}
